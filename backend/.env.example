# Any env var whose name contains API_KEY and whose value starts with sk-or- is loaded as an OpenRouter key.
# Use several keys from different OpenRouter accounts to multiply the free daily quota (50 req/day/account).
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_API_KEY_2=sk-or-optional-second-key
OPENROUTER_API_KEY_3=sk-or-optional-third-key
